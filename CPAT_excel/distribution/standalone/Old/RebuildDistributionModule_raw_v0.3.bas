    wb.Names.Add Name:="ADJ_CONS_TOT", RefersTo:="=LAMBDA(decile,sample,ADJ_CONS_PC(decile,sample)*ADJ_POP(decile,sample))"
    wb.Names.Add Name:="TAX_BURDEN_PRE", RefersTo:="=LAMBDA(decile,sample,TOTAL_EFFECT(decile,sample,""mean"")/100*ADJ_CONS_TOT(decile,sample))"
    wb.Names.Add Name:="PIT_SHARE_RAW", RefersTo:="=LAMBDA(decile,BSHARE(IF(PITSourceSwitch=""income"",""pit_share_income"",""pit_share_region""),decile,""Overall"",""mean""))"
    wb.Names.Add Name:="PIT_SHARE_SUM", RefersTo:="=LAMBDA(SUM(PIT_SHARE_RAW(DECILE_ARRAY)))"
    wb.Names.Add Name:="PIT_LIABILITY", RefersTo:="=LAMBDA(decile,PIT_SHARE_RAW(decile)/PIT_SHARE_SUM()*PITBaselineLCU)"
    wb.Names.Add Name:="TOTAL_ADJ_POP", RefersTo:="=LAMBDA(SUM(BSHARE(""popw"",DECILE_ARRAY,""Overall"",""mean""))*PopAdjFactor)"
    wb.Names.Add Name:="PIT_MAX_TRANSFER_PC", RefersTo:="=LAMBDA(RevLaborTaxLCU/TOTAL_ADJ_POP())"
    wb.Names.Add Name:="PIT_SHORTFALL_TOTAL", RefersTo:="=LAMBDA(SUM(MAX(0,PIT_MAX_TRANSFER_PC()-PIT_LIABILITY(DECILE_ARRAY)/ADJ_POP(DECILE_ARRAY,""Overall""))*ADJ_POP(DECILE_ARRAY,""Overall"")))"
    wb.Names.Add Name:="PIT_ADDITIONAL_PC", RefersTo:="=LAMBDA(PIT_SHORTFALL_TOTAL()/TOTAL_ADJ_POP())"
    wb.Names.Add Name:="PIT_LIABILITY_TOTAL_EXEMPT", RefersTo:="=LAMBDA(SUM(IF(DECILE_ARRAY<=ExemptBottomDeciles_PIT,PIT_LIABILITY(DECILE_ARRAY),0)))"
    wb.Names.Add Name:="PIT_REDUCTION", RefersTo:="=LAMBDA(decile,LET(liability,PIT_LIABILITY(decile),pop,ADJ_POP(decile,""Overall""),prop_amt,liability*LaborTaxCutCoef,pa_pc,MIN(PIT_MAX_TRANSFER_PC(),li" & "ability/pop)+PIT_ADDITIONAL_PC(),pa_amt,pa_pc*pop,te_scale,MIN(1,RevLaborTaxLCU/PIT_LIABILITY_TOTAL_EXEMPT()),te_amt,IF(decile<=ExemptBottomDeciles_PI" & "T,liability*te_scale,0),IF(LaborTaxMethod=""Proportional Compensation"",prop_amt,IF(LaborTaxMethod=""Personal Allowance"",pa_amt,te_amt))))"
    wb.Names.Add Name:="TOTAL_UNSERVED_POP", RefersTo:="=LAMBDA(SUM(BSHARE(""popw"",DECILE_ARRAY,""Overall"",""mean"")*(1-BSHARE(""all_acs_share"",DECILE_ARRAY,""Overall"",""mean"")/100)))"
    wb.Names.Add Name:="INFRA_SHARE", RefersTo:="=LAMBDA(decile,LET(pop,BSHARE(""popw"",decile,""Overall"",""mean""),access,BSHARE(""all_acs_share"",decile,""Overall"",""mean""),(pop*(1-access/100))/TOTAL_UNSERV" & "ED_POP()))"
    wb.Names.Add Name:="TARGETED_TRANSFER", RefersTo:="=LAMBDA(decile,RevTargetedTransferLCU*INFRA_SHARE(decile))"
    wb.Names.Add Name:="PUBLIC_INVESTMENT", RefersTo:="=LAMBDA(decile,RevPublicInvestLCU*INFRA_SHARE(decile))"
    wb.Names.Add Name:="ASPIRE_PC", RefersTo:="=LAMBDA(program,decile,LET(q,ROUNDUP(decile/2,0),XLOOKUP(program,ASPIRE_Programs,INDEX(ASPIRE_Values,0,q))))"
    wb.Names.Add Name:="ASPIRE_TOTAL", RefersTo:="=LAMBDA(program,SUMPRODUCT(ASPIRE_PC(program,DECILE_ARRAY)*BSHARE(""popw"",DECILE_ARRAY,""Overall"",""mean"")))"
    wb.Names.Add Name:="ASPIRE_SHARE", RefersTo:="=LAMBDA(program,decile,LET(pop,BSHARE(""popw"",decile,""Overall"",""mean""),pc,ASPIRE_PC(program,decile),(pc*pop)/ASPIRE_TOTAL(program)))"
    wb.Names.Add Name:="CURRENT_SPENDING", RefersTo:="=LAMBDA(decile,RevCurrentSpendLCU*ASPIRE_SHARE(""allsp"",decile))"
    wb.Names.Add Name:="AMOUNT_RECYCLED", RefersTo:="=LAMBDA(decile,PIT_REDUCTION(decile)+TARGETED_TRANSFER(decile)+PUBLIC_INVESTMENT(decile)+CURRENT_SPENDING(decile))"
    wb.Names.Add Name:="TOTAL_RECYCLED", RefersTo:="=LAMBDA(SUM(AMOUNT_RECYCLED(DECILE_ARRAY)))"
    wb.Names.Add Name:="NET_EFFECT", RefersTo:="=LAMBDA(decile,sample,(TOTAL_EFFECT(decile,sample,""mean"")/100-AMOUNT_RECYCLED(decile)/ADJ_CONS_TOT(decile,sample))*100)"
    wb.Names.Add Name:="POST_CP_EXCL_RECYCLING", RefersTo:="=LAMBDA(decile,sample,ADJ_CONS_TOT(decile,sample)*(1-TOTAL_EFFECT(decile,sample,""mean"")/100))"
    wb.Names.Add Name:="POST_CP_INCL_RECYCLING", RefersTo:="=LAMBDA(decile,sample,POST_CP_EXCL_RECYCLING(decile,sample)+AMOUNT_RECYCLED(decile))"
    On Error GoTo 0
End Sub


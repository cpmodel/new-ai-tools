    wb.Names.Add Name:="DIRECT_EFFECT", RefersTo:="=LAMBDA(fuel,fuellabel,sharecol,elastcol,decile,sample,stat,LET(price,PCHANGE_DIRECT(fuel)*ELASTADJ(fuel,decile),bs,BSHARE(sharecol,decile,sample,stat" & "),raw,(bs/100)*(price/100)*BEHAVIOR_ADJ()*100-DWL(sharecol,elastcol,decile,sample,stat,price),exempt,IF(AND(ExemptSwitch=""Yes"",fuellabel=ExemptFuelLab" & "el,decile<=ExemptDeciles,decile>0),1-ExemptShare,1),raw*exempt))"

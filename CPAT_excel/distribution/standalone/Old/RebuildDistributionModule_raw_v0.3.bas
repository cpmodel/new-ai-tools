    wb.Names.Add Name:="TOTAL_EFFECT", RefersTo:="=LAMBDA(decile,sample,stat,TOTAL_DIRECT_EFFECT(decile,sample,stat)+TOTAL_INDIRECT_EFFECT(decile,sample,stat))"
    wb.Names.Add Name:="ADJ_POP", RefersTo:="=LAMBDA(decile,sample,BSHARE(""popw"",decile,sample,""mean"")*PopAdjFactor)"

Attribute VB_Name = "RebuildDistributionModule"
' Rebuilds the named LAMBDA functions and all Distribution_Outputs /
' Distribution_Inputs formulas via Excel's own object model, so Excel
' itself performs the internal _xlfn/_xlpm encoding instead of relying
' on formula text written directly into the .xlsx XML.
' Usage: Alt+F11 -> Insert -> Module -> paste this file -> F5 (or run
' RebuildDistributionModule from the macro list). Run once after opening
' the workbook; safe to re-run.
Option Explicit

Sub RebuildDistributionModule()
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    AddDistributionNames
    WriteFormulas_Part1
    WriteFormulas_Part2
    WriteFormulas_Part3
    WriteFormulas_Part4
    WriteFormulas_Part5
    WriteFormulas_Part6
    WriteFormulas_Part7
    WriteFormulas_Part8
    WriteFormulas_Part9
    WriteFormulas_Part10
    WriteFormulas_Part11
    WriteFormulas_Part12
    Application.Calculation = xlCalculationAutomatic
    Application.CalculateFullRebuild
    Application.ScreenUpdating = True
    MsgBox "Distribution module rebuilt: " & Names.Count & _
        " names, 1397 formulas.", vbInformation
End Sub

